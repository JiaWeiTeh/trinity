# TRINITY .gitignore: an allowlist. Everything is ignored unless listed below.
# Machine-local ignore rules go in .git/info/exclude, which is never pushed.

# 1. Ignore everything at the top level, then allow the public parts back in.
/*
!/.gitignore
!/.github/
!/.pre-commit-config.yaml
!/CHANGELOG.md
!/CITATION.cff
!/CONTRIBUTING.md
!/LICENSE
!/MANIFEST.in
!/README.md
!/pyproject.toml
!/requirements.txt
!/run.py
!/trinity/
!/test/
!/tools/
!/examples/
!/lib/
!/param/
!/paper/

# 2. Inside those folders, allow only the public parts.
/lib/*
!/lib/default/

/param/*
!/param/*_example.param
!/param/cloud_example_*.param
!/param/simple_cluster*.param
!/param/paperII_grid_sweep*.param

/paper/*
!/paper/__init__.py
!/paper/_lib/
!/paper/methods/

/examples/web/

# 3. Never tracked anywhere: AI-assistant files and session hand-off prompts.
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.claude/
.agents/
.codex/
PROMPT_*.md

# 4. Generated and local files.
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
pytest-cache-files-*/
.mypy_cache/
.ruff_cache/
.venv/
venv/
.env
.env.*
.DS_Store
*.icloud
*.swp
*.swo
*~
*.bak
*.tmp
*.log
def_dir/
to-be-deleted/
