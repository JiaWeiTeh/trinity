# BATCH 5 — FB_thermCoeffWind = 0.01 across all three cloud regimes (3 runs).
# Last rung. v_wind ~200 km/s — still supersonic, still valid (PLAN §2).
#
#   python run.py docs/dev/weak-winds/harness/batches/batch5_c0p01.param --workers 3 --yes
#   python docs/dev/weak-winds/harness/check_batch.py outputs/weak_winds_study/c0p01
#
# Each batch writes to its own subdirectory (run folder names do NOT encode a
# fixed, non-swept knob, so batches sharing one directory would collide).
# See ../../RUNBOOK.md for the gate and the descent rules.

tuple(mCloud, sfe, nCore)    [1e5, 0.30, 1e5] [1e7, 0.50, 1e2] [1e7, 0.01, 1e6]

FB_thermCoeffWind    0.01

stop_t    15
path2output    outputs/weak_winds_study/c0p01
