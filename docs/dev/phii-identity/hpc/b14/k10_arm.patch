+def _k10_front_radius(R2, Qi, n0, chi_e, alpha_B, sigma_d):
+    """Ionisation-front radius of a uniform-density layer, WITH dust absorption.
+
+    Solves the code's own ionised-region photon equation (get_shellODE.py:120) at
+    constant density n0, phi(R2) = 1, for the radius where phi = 0:
+
+        dphi/dr = -A r**2 - k phi     A = 4 pi chi_e alpha_B n0**2 / Qi,  k = n0 sigma_d
+
+    i.e. recombination and dust competing for the same photons -- so this is a
+    reduction of trinity's own dust treatment, not a second model of it. Closed form
+    via the integrating factor, root-found on [R2, R_i_nodust]. Dust only removes
+    photons faster, so the no-dust radius is a GUARANTEED upper bracket (phi < 0
+    there) and the root always exists -- there is no non-convergence branch.
+
+    Validated offline before it was written: the closure's own predicted dust
+    fraction reproduces the shell solve's measured shell_fIonisedDust to 5.6%
+    (median ratio 1.056, 97.3% of rows within 25%) -- docs/dev/phii-identity/
+    PLAN.md Batch 17, data/b17_dust_closure.csv.
+    """
+    A = 4.0 * np.pi * chi_e * alpha_B * n0**2 / Qi
+    hi = (R2**3 + 3.0 / A) ** (1.0 / 3.0)      # phi = 1 - A(r^3 - R2^3)/3 = 0
+    k = n0 * sigma_d
+    if k * (hi - R2) < 1e-8:                   # layer optically thin to dust
+        return hi
+
+    def _phi(r):
+        e = np.exp(-k * (r - R2))
+        # P(s) = integral of s^2 e^{ks}, factored so no large exponential survives
+        def P(s):
+            return s * s / k - 2.0 * s / k**2 + 2.0 / k**3
+        return e - A * (P(r) - e * P(R2))
+
+    return scipy.optimize.brentq(_phi, R2, hi, xtol=1e-14, rtol=1e-15)
+
+
+def get_phii_k10(params, shell_props):
+    """Photoionised pressure from the coupled (CEM) closure -- the K10 scheme.
+
+    ARM CODE (docs/dev/phii-identity/PLAN.md Batch 18). This is NOT the shipped
+    scheme; it is measured against C3c and adopting it is a maintainer decision (D5,
+    deliberately still open). Do not flip a default on the strength of this function.
+
+    Unlike C3c, this has NO BRANCH: the drive is a single smooth function of
+    (R2, Qi, P_conf), which is why its state-jump at the old regime switch is
+    identically zero where the shipped rule jumps +34.0% (Batch 13, at fixed state).
+
+        n0    = (mu_i/mu_c) * P_conf / (k_B T)     == shell_structure.py:125's nShell0
+        R_i   from the dusty front above           (Batch 17)
+        drive = P_conf * (R_i/R2)**2               (Lancaster+2025, arXiv:2505.22730)
+
+    P_conf is the RAMPED effective pressure, not params['Pb']: inside dt_switchon the
+    two differ by 0.3302-0.9952 (Batch 16 G16.3), and using the un-ramped value would
+    re-admit the D-ramp defect class C3c removed. Every input to
+    get_effective_bubble_pressure is already in params, so no signature change and no
+    call-site edits are needed -- Batch 16's contrary conclusion is retracted in
+    Batch 18's registration.
+
+    RETURN CONVENTION (Batch 16, verified to 2.22e-16 through the real P_drive
+    expressions): this returns the CEM drive MINUS whatever the phase's own
+    composition already contributes, so the existing expressions compose it exactly --
+
+        energy/implicit   max(P_conf, P_HII)            <- return P_conf*rho
+        transition        max(P_conf, P_HII + P_ram)    <- return P_conf*rho - P_ram
+        momentum          P_HII + P_ram                 <- return P_ram*(rho - 1)
+
+    A single return convention CANNOT satisfy all three; that is the defect Batch 14
+    found in the original "the excess rides the existing compositions" claim.
+
+    Note this deliberately breaks C3c's exact-0.0 confined contract (test_phii_c3c.py
+    pins it): K10 returns a small positive excess there, Lancaster's first-order term,
+    +0.96% of P_conf at the median. That is Batch 18's G18.1 and is reported, not hidden.
+    """
+    R2 = params['R2'].value
+    Qi = params['Qi'].value
+    if not (R2 > 0 and Qi > 0):
+        return 0.0
+
+    phase = params['current_phase'].value
+    Lmech_total = params['Lmech_total'].value
+    v_mech_total = params['v_mech_total'].value
+    Eb = params['Eb'].value
+    # R1 via solve_R1 rather than params['R1'], matching the ODE's own canonical call
+    # (energy_phase_ODEs.py:221) so this cannot read a stale radius.
+    R1 = solve_R1(R2, Eb, Lmech_total, v_mech_total)
+    P_conf = get_effective_bubble_pressure(
+        current_phase=phase,
+        Eb=Eb, R2=R2, R1=R1, gamma=params['gamma_adia'].value,
+        Lmech_total=Lmech_total, v_mech_total=v_mech_total,
+        t=params['t_now'].value, tSF=params['tSF'].value,
+    )
+    if not (P_conf > 0.0):
+        return 0.0
+
+    n0 = (params['mu_ion_shell'].value / params['mu_convert'].value
+          / (params['k_B'].value * params['TShell_ion'].value) * P_conf)
+    if not (n0 > 0.0):
+        return 0.0
+
+    R_i = _k10_front_radius(R2, Qi, n0, params['chi_e_shell'].value,
+                            params['caseB_alpha'].value, params['dust_sigma'].value)
+    rho = (R_i / R2) ** 2
+
+    # P_ram computed directly, never read from params['P_ram'], so this helper carries
+    # no dependence on call ordering within the phase runners.
+    if phase == 'momentum':
+        return float(pRam(R2, Lmech_total, v_mech_total) * (rho - 1.0))
+    if phase == 'transition':
+        return float(P_conf * rho - pRam(R2, Lmech_total, v_mech_total))
+    return float(P_conf * rho)
+
+
