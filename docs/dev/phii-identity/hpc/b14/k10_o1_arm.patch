+# Must come AFTER get_phii_k10's definition. NOT a default flip -- this file is
+# applied as an arm patch and never merged (D5 is deliberately open).
+get_phii_c3c = get_phii_k10
+# -------------------------------------------------------------------------------
+
+
 def get_effective_bubble_pressure(current_phase, Eb, R2, R1, gamma,
