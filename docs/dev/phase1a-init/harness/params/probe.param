# Single TRINITY run at M43 scale.
mCloud                  300         # Msun
sfe                     0.01        # -> Mstar = 3.0 Msun (Q-matched to N_LyC = 1.6e47)
nCore                   8.7e3       # cm^-3
include_PHII            True
dens_profile            densPL
densPL_alpha            0           # homogeneous; nCore is then the ambient density
rCore                   0.05        # pc. MUST be set: the 1 pc default exceeds rCloud here
                                    # (rCloud = 0.617 pc for this mCloud/nCore).
nISM                    1e2         # cm^-3
PISM                    2.3e5       # K cm^-3
ZCloud                  1
coverFraction           1.0
TShell_neu              135         # K (measured shell temperature; default is 100)
stop_t                  0.1         # Myr = 1e5 yr, ~5x the observed age
stop_r                  None
stop_at_rCloud_nSnap    None
coll_r                  0.005       # pc. The min-radius terminal event fires at
                                    # max(coll_r*1.5, 0.01 pc); the usual coll_r=1 would put
                                    # that floor at 1.5 pc, ten times this whole object.
allowShellDissolution   True
stop_t_diss             1
log_level               INFO
path2output             outputs/m43_probe/
